PORT=4000

# PostgreSQL (Supabase). Copiar la cadena desde Supabase > Connect.
# Session Pooler (recomendado si no hay IPv6):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Conexion directa:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth: se usa para validar el access token que manda el frontend.
# Es la misma URL y publishable/anon key del cliente (son publicas).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Solo para scripts/test-api.js (no se usa en el servidor).
TEST_EMAIL=
TEST_PASSWORD=
