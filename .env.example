# =====================================================================
# Servidor
# =====================================================================
PORT=4000

# Cadena de conexión a PostgreSQL (Supabase).
# Ejemplo: postgresql://postgres.PROYECTO:CLAVE@aws-0-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase (pooler) exige SSL: poner true en ese caso.
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# =====================================================================
# Validación del login (Supabase Auth)
# Se usa para dejar importar productos solo a un ADMINISTRADOR activo.
# =====================================================================
# URL del proyecto: https://PROYECTO.supabase.co
SUPABASE_URL=
# Solo para proyectos con JWT de secreto compartido (HS256).
# Los proyectos nuevos validan con el JWKS público y no necesitan esto.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# =====================================================================
# Importación de productos desde Excel
# =====================================================================
# Tamaño máximo del archivo (MB) y filas máximas por importación.
IMPORT_MAX_MB=5
IMPORT_MAX_FILAS=2000
# Cuántos productos se insertan por sentencia SQL (1 a 2000).
IMPORT_LOTE_INSERCION=500
# "p001" y "P001" cuentan como el mismo código.
IMPORT_CODIGO_SIN_MAYUSCULAS=true
# Si la categoría de la planilla no existe, se crea sola.
IMPORT_CREAR_CATEGORIAS=true
# SOLO DESARROLLO LOCAL: deja el endpoint sin login. NUNCA en producción.
IMPORT_PERMITIR_SIN_AUTH=false

# =====================================================================
# Logs (una línea JSON por evento, un archivo por día)
# =====================================================================
LOG_DIR=./logs
# error | warn | info | debug | silent
LOG_NIVEL=info
LOG_ARCHIVO=true
